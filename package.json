{
  "name": "festpage-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --filter \"./apps/*\" run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "db:generate": "pnpm --filter @festpage/db run generate",
    "db:migrate": "pnpm --filter @festpage/db run migrate",
    "db:seed": "pnpm --filter @festpage/db run seed",
    "db:studio": "pnpm --filter @festpage/db run studio",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.4.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
