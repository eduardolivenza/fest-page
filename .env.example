# Copy to .env and fill in values

# API (apps/api, Spring Boot). Gradle does not read this file: export it first, e.g.
#   set -a; . ./.env; set +a; pnpm api:dev
# PostgreSQL (docker compose up postgres); the api applies the Flyway migrations on start.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/festpage
SPRING_DATASOURCE_USERNAME=festpage
SPRING_DATASOURCE_PASSWORD=festpage_dev
# At least 32 bytes (HS256); the api refuses to start otherwise.
JWT_SECRET=change-me-to-a-long-random-string-of-32-bytes-or-more
PORT=3001
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
# Cloudflare Turnstile (optional; these are Cloudflare's always-pass test keys)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Public web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Admin (apps/admin)
# NEXT_PUBLIC_API_URL=http://localhost:3001
